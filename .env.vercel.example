# Copy these KEYS into Vercel -> Project -> Settings -> Environment Variables.
# Supply your real values. Never commit filled values.
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
FILE_SIGNING_SECRET=
CRON_SECRET=
ADMIN_EMAIL=kelvin@sabroking.co.za
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=Kelvin

STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for the documented R2 setup; false is also supported for AWS S3.
S3_FORCE_PATH_STYLE=true

EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# false with STARTTLS on 587; true with TLS on 465.
SMTP_SECURE=false

OCR_PROVIDER=tesseract
OCR_CACHE_PATH=/tmp/.tesseract-cache
MAX_UPLOAD_BYTES=15728640
MAX_PAGES_PER_RECEIPT=10
# Optional at first deployment; app derives the Vercel production URL.
# Once your final domain is ready, set both values to the full HTTPS origin.
# NEXT_PUBLIC_APP_URL=https://your-domain.example
# AUTH_URL=https://your-domain.example
