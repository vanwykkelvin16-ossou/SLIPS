# ---------------------------------------------------------------------------
# Slipsy environment
#
# Copy to `.env` and fill in. Everything marked REQUIRED must be set before the
# app will start — misconfiguration fails loudly at boot rather than at the
# first upload.
#
# Generate every secret with:  openssl rand -base64 48
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) ---------------------------------------------------
# Any PostgreSQL 14+ instance. Managed Postgres (Neon, Supabase, RDS, Railway)
# works as-is; add ?sslmode=require for hosted databases.
# DIRECT_URL is the non-pooled connection string, used only for migrations.
# Set it when your provider gives a pooled and a direct URL (Neon, Supabase,
# Vercel Postgres). With only one string, leave it unset.
# DIRECT_URL="postgresql://..."

DATABASE_URL="postgresql://user:password@localhost:5432/slipsy?schema=public"

# --- Sessions and signing (REQUIRED) ---------------------------------------
# AUTH_SECRET signs customer sessions. At least 32 characters.
AUTH_SECRET="change-me-openssl-rand-base64-48"

# Public URL of the deployment. Used for links in e-mails and for CSRF checks.
AUTH_URL="https://slips.example.com"
NEXT_PUBLIC_APP_URL="https://slips.example.com"

# Signs the short-lived URLs that serve receipt documents and exports.
# Must be different from AUTH_SECRET. At least 32 characters.
FILE_SIGNING_SECRET="change-me-openssl-rand-base64-48"

# Signs admin-portal sessions. Optional: when unset it is derived from
# AUTH_SECRET, which is fine — set it only if you want admin sessions to be
# invalidated independently of customer sessions.
# ADMIN_SESSION_SECRET="change-me-openssl-rand-base64-48"

# --- Admin portal (REQUIRED for first run) ---------------------------------
# Seeds the initial administrator with `npm run seed:admin`. Only a bcrypt hash
# is stored; the password below is never written to the database or any log.
# Change the password from inside the portal straight after the first sign-in.
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Administrator"
# Set to true to reset an existing admin's password on the next seed run.
# ADMIN_FORCE_PASSWORD_RESET="false"

# --- Document storage ------------------------------------------------------
# local: files on the server's own disk. Good for a single-server deployment;
#        the directory must be on persistent storage and outside the web root.
# s3:    any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
#        The bucket MUST have all public access blocked.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# S3_* are required when STORAGE_DRIVER=s3.
# S3_BUCKET="slipsy-documents"
# S3_REGION="eu-west-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Set for R2/B2/MinIO; leave unset for AWS S3.
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="false"

# --- Reading documents (OCR) -----------------------------------------------
# tesseract: runs on your own server, no credentials, no data leaves the host.
#            Reads images directly and PDFs via their embedded text layer.
#            Scanned PDFs need one of the cloud providers below.
# google-vision / aws-textract / azure-document-intelligence: better accuracy
#            and native scanned-PDF support; each needs its own credentials.
OCR_PROVIDER="tesseract"

# Where Tesseract caches its language data. Must be writable.
OCR_CACHE_PATH="./.tesseract-cache"
# Optional: a directory containing eng.traineddata.gz. Leave unset to use the
# copy installed with the @tesseract.js-data/eng dependency.
# OCR_LANG_PATH=""
# Give up on a document after this long (milliseconds).
# OCR_TIMEOUT_MS="90000"

# GOOGLE_VISION_API_KEY=""
# AWS_TEXTRACT_REGION="eu-west-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AZURE_DOCUMENT_ENDPOINT="https://<resource>.cognitiveservices.azure.com"
# AZURE_DOCUMENT_KEY=""

# --- E-mail ----------------------------------------------------------------
# console: writes a one-line notice and the action link to the server log.
#          Fine for development; verification and reset links still work.
# smtp:    real delivery. Required in production for password resets.
EMAIL_PROVIDER="console"
EMAIL_FROM="Slipsy <no-reply@slips.example.com>"
# SMTP_HOST="smtp.postmarkapp.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_SECURE="true"

# --- Malware scanning ------------------------------------------------------
# none:    structural checks only (executables are rejected by signature).
# clamav:  stream uploads to a clamd instance.
# webhook: POST uploads to a scanning service that answers {"clean": true}.
# clamav and webhook both fail closed: an unreachable scanner rejects the upload.
MALWARE_SCAN_PROVIDER="none"
# CLAMAV_HOST="clamav"
# CLAMAV_PORT="3310"
# MALWARE_SCAN_WEBHOOK_URL=""

# --- Limits ----------------------------------------------------------------
# 15 MB per page.
MAX_UPLOAD_BYTES="15728640"
MAX_PAGES_PER_RECEIPT="10"
# How long a built export archive stays downloadable.
EXPORT_RETENTION_HOURS="72"

# --- Serverless hosts only (Vercel, Lambda) --------------------------------
# Authorises the scheduled export run at /api/cron/exports. Without it the
# endpoint returns 503 and refuses to do anything. Vercel sets the matching
# Authorization header on its cron calls automatically.
# Generate with: openssl rand -base64 32
# CRON_SECRET="change-me"

# --- Rate limiting ---------------------------------------------------------
# The defaults suit a production deployment. Raise them for load testing, or
# for an office where many users share one outbound IP. There is no setting
# that turns rate limiting off.
# RATE_LIMIT_LOGIN="10"            # per IP per 15 minutes
# RATE_LIMIT_SIGNUP="5"            # per IP per hour
# RATE_LIMIT_PASSWORD_RESET="5"    # per IP per hour
# RATE_LIMIT_UPLOAD="60"           # per user per 10 minutes
# RATE_LIMIT_EXPORT="20"           # per user per hour
# RATE_LIMIT_MUTATION="300"        # per user per 5 minutes
# RATE_LIMIT_READ="600"            # per user per 5 minutes

# --- Export worker ---------------------------------------------------------
# Only needed when running `npm run worker:exports` (see the README).
# EXPORT_WORKER_INTERVAL_MS="15000"
